# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/loop_ai_feedback"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: only needed once AI classification (lib/ai.ts) is implemented
ANTHROPIC_API_KEY=""
